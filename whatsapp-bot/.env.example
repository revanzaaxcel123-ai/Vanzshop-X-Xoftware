VANZSHOP_BASE_URL=https://store.vanzshop.com
# website = memakai API website yang sudah terkonfigurasi; direct = akses provider dari Node.js
WA_BACKEND_MODE=website
# Aktifkan hanya setelah frontend pembayaran baru sudah dideploy. Hasil tetap dikirim di chat.
WA_WEB_PAYMENT_LINKS=false
# Katalog/QRIS di grup; detail produk hanya dikirim ke chat pribadi pembeli.
WA_GROUPS_ENABLED=true
# Taruh banner milik toko di folder bot. Jika belum ada, katalog tetap dikirim sebagai teks.
WA_BANNER_FILE=./banner.png
# Mode direct: isi sesuai Environment Variables Vercel, jangan buat Redis/prefix baru.
XSOFTWARE_API_KEY=
SEWAPAY_API_KEY=
SEWAPAY_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FULFILLMENT_KEY_PREFIX=vanzshop:v13
PAYMENT_TOKEN_SECRET=
# true setelah Redis/prefix/token secret dipastikan sama dengan website.
WA_SHARED_STORE_CONFIRMED=false
WA_LOGIN_METHOD=qr
WA_PHONE_NUMBER=628xxxxxxxxxx
WA_ADMIN_NUMBER=62895415204928
WA_SUPPORT_URL=https://wa.me/62895415204928
WA_WARRANTY_URL=https://ketentuan-garansi.vanzshop.com
WA_TIMEZONE=Asia/Jakarta
WA_AUTH_DIR=./data/auth
WA_STATE_FILE=./data/pending-orders.json
WA_SESSION_TTL_MINUTES=30
WA_CATALOG_CACHE_SECONDS=10
WA_PAYMENT_POLL_SECONDS=10
WA_RECONNECT_DELAY_MS=3000
WA_LOG_LEVEL=info
