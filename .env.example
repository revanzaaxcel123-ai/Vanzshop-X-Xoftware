# WAJIB — Xoftware sebagai sumber katalog + stok akun
XSOFTWARE_API_KEY=YOUR_REAL_XOFTWARE_API_KEY

# WAJIB — Sewa Pay sebagai payment gateway
SEWAPAY_API_KEY=pg_your_api_key
SEWAPAY_SECRET_KEY=sk_your_secret_key

# WAJIB — idempotency + order/fulfillment state (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
# Alternatif nama env yang juga didukung:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# WAJIB — dashboard admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# OPSIONAL — token order internal; jika kosong fallback ke SEWAPAY_SECRET_KEY
PAYMENT_TOKEN_SECRET=

# OPSIONAL — fulfillment retention / namespace
FULFILLMENT_KEY_PREFIX=vanzshop:v13
FULFILLMENT_TTL_DAYS=30
FULFILLMENT_HOLD_TTL_SECONDS=1800
FULFILLMENT_LOCK_TTL_SECONDS=120
FULFILLMENT_STOCK_CLAIM_TTL_DAYS=365
# true = stok Xoftware ini eksklusif untuk VanzShop / semua channel lain wajib pakai reservation yang sama
FULFILLMENT_EXCLUSIVE_STOCK=true

# OPSIONAL timeout
XSOFTWARE_TIMEOUT=25000
SEWAPAY_TIMEOUT=25000
SEWAPAY_WEBHOOK_MAX_SKEW=900

# LEGACY XOFTWARE CHECKOUT (tidak dipakai storefront v13; tetap ada untuk admin/diagnostic)
XSOFTWARE_CHECKOUT_MODE=user
XSOFTWARE_SHARED_CHANNEL=whatsapp
XSOFTWARE_SHARED_SENDER=
XSOFTWARE_SHARED_NAME=VanzShop Checkout

# IDENTITAS TOKO
STORE_NAME=VanzShop.com
STORE_TAGLINE=Produk digital pilihan, stok live, checkout otomatis.
STORE_WHATSAPP=0895415204928
STORE_TELEGRAM=
STORE_EMAIL=
STORE_RESELLER_WHATSAPP=0895415204928
STORE_RESELLER_GROUP=https://chat.whatsapp.com/DQ2PsowpGt5FxhQDAS2sAz

# TAMPILAN
STORE_THEME=dark
STORE_COLOR_MODE=dark
STORE_ACCENT=#f3c74f
STORE_RADIUS=20
STORE_COLUMNS=5
STORE_DENSITY=compact
STORE_HERO=true
STORE_BANNER_SECONDS=4.2

# BRANDING V15
STORE_BRAND_MARK=V
STORE_BRAND_SUBTITLE=PRODUK DIGITAL
STORE_LOGO_URL=
STORE_HERO_TITLE=Pusat Premium Digital Termurah
STORE_HERO_SUBTITLE=Produk digital pilihan dengan stok real-time, checkout ringkas, dan pengiriman akun otomatis setelah pembayaran berhasil.
STORE_HERO_BADGES=Harga bersaing,Stok real-time,Pembayaran aman,Proses otomatis
STORE_HERO_SLIDES=/assets/banner/banner1.jpg,/assets/banner/banner2.jpg,/assets/banner/banner3.jpg,/assets/banner/banner4.jpg,/assets/banner/banner5.jpg
STORE_RECEIPT_NOTE=Detail akun dikirim otomatis dari stok aktif. Simpan data login dan segera ganti jika diperlukan.
STORE_FOOTER_NOTE=Produk digital hemat · stok real-time · proses otomatis
STORE_FONT_BODY=Plus Jakarta Sans
STORE_FONT_DISPLAY=Archivo
