# WAJIB
XSOFTWARE_API_KEY=YOUR_REAL_XOFTWARE_API_KEY
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD  # isi tanpa tanda kutip

# OPSIONAL
XSOFTWARE_TIMEOUT=25000

# MODE CHECKOUT
# user   = setiap pembeli harus menjadi user Xoftware (butuh /v1/register untuk user baru)
# shared = semua order QRIS memakai SATU sender Xoftware existing; buyer tidak diregistrasikan
XSOFTWARE_CHECKOUT_MODE=user
XSOFTWARE_SHARED_CHANNEL=whatsapp
XSOFTWARE_SHARED_SENDER=
XSOFTWARE_SHARED_NAME=VanzShop Checkout

# IDENTITAS TOKO
STORE_NAME=VanzShop.com
STORE_TAGLINE=Produk digital pilihan, stok live, checkout otomatis.
STORE_WHATSAPP=
STORE_TELEGRAM=
STORE_EMAIL=

# TAMPILAN
STORE_THEME=dark
STORE_ACCENT=#f3c74f
STORE_RADIUS=20
STORE_COLUMNS=5
STORE_DENSITY=compact
STORE_HERO=true
