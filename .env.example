# WAJIB
XSOFTWARE_API_KEY=YOUR_REAL_XOFTWARE_API_KEY
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# OPSIONAL - hanya default untuk operasi admin tertentu, BUKAN fallback checkout publik
XSOFTWARE_DEFAULT_SENDER=
XSOFTWARE_DEFAULT_NAME=VanzShop.com
XSOFTWARE_TIMEOUT=25000
CATALOG_SOURCE=owner

# IDENTITAS TOKO
STORE_NAME=VanzShop.com
STORE_TAGLINE=Produk digital pilihan, stok live, checkout otomatis.
STORE_WHATSAPP=
STORE_TELEGRAM=
STORE_EMAIL=

# TAMPILAN GLOBAL (bisa digenerate dari Dashboard -> Tampilan)
STORE_THEME=dark
STORE_ACCENT=#f3c74f
STORE_RADIUS=20
STORE_COLUMNS=5
STORE_DENSITY=compact
STORE_HERO=true
